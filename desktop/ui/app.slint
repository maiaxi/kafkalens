import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct ConnectionItem {
    name: string,
    bootstrap: string,
}

export struct TopicItem {
    name: string,
    partitions: int,
    internal: bool,
}

export struct MessageRow {
    partition: string,
    offset: string,
    timestamp: string,
    key: string,
    value: string,
    key-null: bool,
    value-null: bool,
}

export struct HeaderItem {
    key: string,
    value: string,
}

export struct MessageDetail {
    present: bool,
    partition: string,
    offset: string,
    timestamp: string,
    key: string,
    key-format: string,
    value: string,
    value-format: string,
    size: string,
    headers: [HeaderItem],
}

// Small caps section title, as in the macOS sidebar.
component SectionTitle inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Palette.foreground.with-alpha(0.55);
}

component Divider inherits Rectangle {
    background: Palette.border;
}

component SelectableRow inherits Rectangle {
    in property <bool> selected;
    callback clicked();

    border-radius: 6px;
    background: selected ? Palette.accent-background.with-alpha(0.85) : touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Draggable boundary between panes. `size` is the width of the pane it
// resizes; `grows-left` is for panes on the right, which widen when dragged
// left. Each move applies the delta since the last event: the splitter moves
// with the pane, so the pointer position is relative to its new place.
component Splitter inherits Rectangle {
    in-out property <length> size;
    in property <length> min-size;
    in property <length> max-size;
    in property <bool> grows-left;

    width: 7px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: touch.has-hover || touch.pressed ? 3px : 1px;
        background: touch.has-hover || touch.pressed ? Palette.accent-background : Palette.border;
        animate width, background { duration: 120ms; }
    }
    touch := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if self.pressed {
                root.size = clamp(
                    root.size + (root.grows-left ? -1 : 1) * (self.mouse-x - self.pressed-x),
                    root.min-size, root.max-size);
            }
        }
    }
}

// Flat icon button for the toolbar; highlighted while its pane is open.
component IconToggle inherits Rectangle {
    in property <image> icon;
    in-out property <bool> checked;

    width: 30px;
    height: 28px;
    border-radius: 6px;
    background: touch.pressed ? Palette.foreground.with-alpha(0.14)
        : checked ? Palette.foreground.with-alpha(0.09)
        : touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: root.checked ? Palette.foreground : Palette.foreground.with-alpha(0.5);
    }
    touch := TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}

component ConnectionsPane inherits Rectangle {
    in property <[ConnectionItem]> connections;
    in property <int> selected: -1;
    in property <string> status;
    callback select(int);
    callback add(string, string);

    property <bool> adding: false;

    background: Palette.alternate-background;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        SectionTitle { text: "CONNECTIONS"; }

        ListView {
            vertical-stretch: 1;
            for connection[index] in root.connections: SelectableRow {
                height: 46px;
                selected: index == root.selected;
                clicked => { root.select(index); }

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    Text {
                        text: connection.name;
                        font-weight: 600;
                        color: index == root.selected ? Palette.accent-foreground : Palette.foreground;
                        overflow: elide;
                    }
                    Text {
                        text: connection.bootstrap;
                        font-size: 11px;
                        color: index == root.selected ? Palette.accent-foreground.with-alpha(0.8) : Palette.foreground.with-alpha(0.55);
                        overflow: elide;
                    }
                }
            }
        }

        if root.status != "": Text {
            text: root.status;
            font-size: 11px;
            wrap: word-wrap;
            color: Palette.foreground.with-alpha(0.6);
        }

        if root.adding: VerticalLayout {
            spacing: 6px;
            name := LineEdit { placeholder-text: "Name"; }
            servers := LineEdit { placeholder-text: "host:9092"; }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "Cancel";
                    clicked => { root.adding = false; }
                }
                Button {
                    text: "Add";
                    primary: true;
                    enabled: name.text != "" && servers.text != "";
                    clicked => {
                        root.add(name.text, servers.text);
                        root.adding = false;
                    }
                }
            }
        }

        if !root.adding: Button {
            text: "+ Add Connection";
            clicked => { root.adding = true; }
        }
    }
}

component TopicsPane inherits Rectangle {
    in property <[TopicItem]> topics;
    in property <string> selected;
    in property <string> hidden-note;
    callback select(string);
    callback filter-changed(string);

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        LineEdit {
            placeholder-text: "Filter topics";
            edited(text) => { root.filter-changed(text); }
        }

        ListView {
            vertical-stretch: 1;
            for topic in root.topics: SelectableRow {
                height: 30px;
                selected: topic.name == root.selected;
                clicked => { root.select(topic.name); }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: topic.name;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        color: topic.name == root.selected ? Palette.accent-foreground
                            : topic.internal ? Palette.foreground.with-alpha(0.55) : Palette.foreground;
                    }
                    Text {
                        text: topic.partitions;
                        vertical-alignment: center;
                        font-size: 11px;
                        color: topic.name == root.selected ? Palette.accent-foreground.with-alpha(0.8) : Palette.foreground.with-alpha(0.5);
                    }
                }
            }
        }

        if root.hidden-note != "": Text {
            text: root.hidden-note;
            font-size: 11px;
            color: Palette.foreground.with-alpha(0.55);
        }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text {
        text: root.label;
        width: 80px;
        color: Palette.foreground.with-alpha(0.55);
    }
    Text {
        text: root.value;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

component Payload inherits VerticalLayout {
    in property <string> title;
    in property <string> format;
    in property <string> text;
    in property <string> mono-font;
    spacing: 6px;

    HorizontalLayout {
        spacing: 8px;
        Text { text: root.title; font-weight: 600; }
        Text {
            text: root.format;
            font-size: 11px;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.55);
        }
    }
    Rectangle {
        background: Palette.foreground.with-alpha(0.05);
        border-radius: 6px;
        VerticalLayout {
            padding: 8px;
            Text {
                text: root.text;
                font-family: root.mono-font;
                font-size: 12px;
                wrap: char-wrap;
            }
        }
    }
}

// Message table. Built from a ListView rather than StandardTableView, whose
// rows only span the columns' minimum widths instead of the full table.
component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <string> arrow;
    callback clicked();

    HorizontalLayout {
        padding-left: 10px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.65);
            overflow: elide;
        }
        Text {
            text: root.arrow;
            font-size: 10px;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.65);
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Cell inherits Text {
    in property <bool> muted;
    in property <bool> selected;
    vertical-alignment: center;
    overflow: elide;
    color: selected ? Palette.accent-foreground : muted ? Palette.foreground.with-alpha(0.45) : Palette.foreground;
}

component MessageTable inherits VerticalLayout {
    in property <[MessageRow]> rows;
    in property <string> mono-font;
    in-out property <int> current-row: -1;
    in property <int> sort-column: 2;
    in property <bool> sort-ascending: false;
    callback row-selected(int);
    callback sort(int);

    function arrow(column: int) -> string {
        return column != root.sort-column ? "" : root.sort-ascending ? "▲" : "▼";
    }

    // Partition, offset and timestamp are fixed; key and value share the
    // rest 1:3. Header and rows use the same constraints so they line up.
    property <[length]> widths: [76px, 76px, 180px];

    Rectangle {
        height: 32px;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            HeaderCell { width: widths[0]; title: "Partition"; arrow: arrow(0); clicked => { root.sort(0); } }
            HeaderCell { width: widths[1]; title: "Offset"; arrow: arrow(1); clicked => { root.sort(1); } }
            HeaderCell { width: widths[2]; title: "Timestamp"; arrow: arrow(2); clicked => { root.sort(2); } }
            HeaderCell {
                min-width: 80px; preferred-width: 0; horizontal-stretch: 1;
                title: "Key"; arrow: arrow(3); clicked => { root.sort(3); }
            }
            HeaderCell {
                min-width: 120px; preferred-width: 0; horizontal-stretch: 3;
                title: "Value"; arrow: arrow(4); clicked => { root.sort(4); }
            }
        }
    }
    Divider { height: 1px; }

    ListView {
        vertical-stretch: 1;
        for row[index] in root.rows: Rectangle {
            property <bool> selected: index == root.current-row;
            height: 30px;

            Rectangle {
                x: 6px;
                width: parent.width - 12px;
                border-radius: 5px;
                background: selected ? Palette.accent-background.with-alpha(0.85)
                    : touch.has-hover ? Palette.foreground.with-alpha(0.07)
                    : mod(index, 2) == 0 ? Palette.foreground.with-alpha(0.035) : transparent;

                // Same 10px inset as the header cells, so columns line up.
                HorizontalLayout {
                    padding-left: 10px;
                    Cell { width: widths[0]; text: row.partition; selected: selected; }
                    Cell { width: widths[1]; text: row.offset; selected: selected; }
                    Cell { width: widths[2]; text: row.timestamp; selected: selected; }
                    Cell {
                        min-width: 80px; preferred-width: 0; horizontal-stretch: 1;
                        text: row.key;
                        font-family: root.mono-font;
                        font-size: 12px;
                        muted: row.key-null;
                        selected: selected;
                    }
                    Cell {
                        min-width: 120px; preferred-width: 0; horizontal-stretch: 3;
                        text: row.value;
                        font-family: root.mono-font;
                        font-size: 12px;
                        muted: row.value-null;
                        selected: selected;
                    }
                }
            }

            touch := TouchArea {
                clicked => {
                    root.current-row = index;
                    root.row-selected(index);
                }
            }
        }
    }
}

component InspectorPane inherits Rectangle {
    in property <MessageDetail> detail;
    in property <string> mono-font;

    background: Palette.alternate-background;

    if !root.detail.present: Text {
        text: "No Message Selected";
        font-size: 15px;
        font-weight: 600;
        color: Palette.foreground.with-alpha(0.45);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.detail.present: ScrollView {
        VerticalLayout {
            padding: 14px;
            spacing: 14px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                Field { label: "Partition"; value: root.detail.partition; }
                Field { label: "Offset"; value: root.detail.offset; }
                Field { label: "Timestamp"; value: root.detail.timestamp; }
                Field { label: "Size"; value: root.detail.size; }
            }

            Payload {
                title: "Key";
                format: root.detail.key-format;
                text: root.detail.key;
                mono-font: root.mono-font;
            }
            Payload {
                title: "Value";
                format: root.detail.value-format;
                text: root.detail.value;
                mono-font: root.mono-font;
            }

            if root.detail.headers.length > 0: VerticalLayout {
                spacing: 4px;
                Text { text: "Headers"; font-weight: 600; }
                for header in root.detail.headers: Field {
                    label: header.key;
                    value: header.value;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Kafkalens";
    preferred-width: 1440px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 560px;

    in property <[ConnectionItem]> connections;
    in property <int> selected-connection: -1;
    in property <string> connection-status;
    in property <[TopicItem]> topics;
    in property <string> selected-topic;
    in property <string> hidden-topics-note;
    in property <[MessageRow]> message-rows;
    in-out property <int> current-row: -1;
    in property <int> sort-column: 2;
    in property <bool> sort-ascending: false;
    in property <MessageDetail> detail;
    in property <string> status-text;
    in property <bool> loading;
    in property <string> mono-font: "Menlo";
    in-out property <int> start-index: 0;
    in-out property <length> connections-width: 210px;
    in-out property <length> topics-width: 240px;
    in-out property <length> inspector-width: 340px;
    in-out property <bool> show-connections: true;
    in-out property <bool> show-topics: true;
    in-out property <bool> show-inspector: true;

    // The message area never gets narrower than this; splitters stop there.
    property <length> center-min: 420px;
    property <length> splitter-width: 7px;
    property <length> left-used: (root.show-connections ? root.connections-width + splitter-width : 0)
        + (root.show-topics ? root.topics-width + splitter-width : 0);
    property <length> right-used: root.show-inspector ? root.inspector-width + splitter-width : 0;
    function room-for(current: length) -> length {
        return root.width - root.left-used - root.right-used - root.center-min + current;
    }
    in-out property <int> limit-index: 1;

    callback select-connection(int);
    callback add-connection(string, string);
    callback select-topic(string);
    callback topic-filter-changed(string);
    callback fetch();
    callback select-message(int);
    callback sort-messages(int);

    HorizontalLayout {
        if root.show-connections: ConnectionsPane {
            width: root.connections-width;
            connections: root.connections;
            selected: root.selected-connection;
            status: root.connection-status;
            select(index) => { root.select-connection(index); }
            add(name, servers) => { root.add-connection(name, servers); }
        }
        if root.show-connections: Splitter {
            size <=> root.connections-width;
            min-size: 160px;
            max-size: max(160px, min(420px, room-for(root.connections-width)));
        }

        if root.show-topics: TopicsPane {
            width: root.topics-width;
            topics: root.topics;
            selected: root.selected-topic;
            hidden-note: root.hidden-topics-note;
            select(name) => { root.select-topic(name); }
            filter-changed(text) => { root.topic-filter-changed(text); }
        }
        if root.show-topics: Splitter {
            size <=> root.topics-width;
            min-size: 160px;
            max-size: max(160px, min(520px, room-for(root.topics-width)));
        }

        // An explicit min-width replaces the one implied by the content, so
        // a wide toolbar or table is clipped instead of pushing the
        // inspector out of the window.
        Rectangle {
            horizontal-stretch: 1;
            min-width: root.center-min;
            clip: true;

            VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;

                    IconToggle {
                        icon: @image-url("icons/sidebar-left.svg");
                        checked <=> root.show-connections;
                        y: (parent.height - self.height) / 2;
                    }
                    IconToggle {
                        icon: @image-url("icons/topics.svg");
                        checked <=> root.show-topics;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.selected-topic == "" ? "No topic selected" : root.selected-topic;
                        overflow: elide;
                        min-width: 60px;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 16px; }
                    Text { text: "From"; vertical-alignment: center; }
                    ComboBox {
                        width: 130px;
                        model: ["Latest", "Beginning"];
                        current-index <=> root.start-index;
                    }
                    Text { text: "Limit"; vertical-alignment: center; }
                    ComboBox {
                        width: 90px;
                        model: ["50", "200", "500", "1000"];
                        current-index <=> root.limit-index;
                    }
                    Button {
                        text: root.loading ? "Fetching…" : "Fetch";
                        primary: true;
                        enabled: root.selected-topic != "" && !root.loading;
                        clicked => { root.fetch(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconToggle {
                        icon: @image-url("icons/sidebar-right.svg");
                        checked <=> root.show-inspector;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Divider { height: 1px; }

                MessageTable {
                    vertical-stretch: 1;
                    rows: root.message-rows;
                    mono-font: root.mono-font;
                    current-row <=> root.current-row;
                    sort-column: root.sort-column;
                    sort-ascending: root.sort-ascending;
                    row-selected(row) => { root.select-message(row); }
                    sort(column) => { root.sort-messages(column); }
                }

                Divider { height: 1px; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    height: 26px;
                    Text {
                        text: root.status-text;
                        font-size: 11px;
                        vertical-alignment: center;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                }
            }
        }

        if root.show-inspector: Splitter {
            size <=> root.inspector-width;
            min-size: 240px;
            max-size: max(240px, min(720px, room-for(root.inspector-width)));
            grows-left: true;
        }
        if root.show-inspector: InspectorPane {
            width: root.inspector-width;
            detail: root.detail;
            mono-font: root.mono-font;
        }
    }
}
